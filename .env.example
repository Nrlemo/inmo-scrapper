# Copiar a .env (ignorado por git) y completar.
TZ=America/Argentina/Buenos_Aires
INMO_DOMAIN=inmo.example.com
TRAEFIK_NETWORK=traefik            # red docker que comparten Traefik y authentik
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure
AUTHENTIK_FORWARD_AUTH_URL=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
# Secreto largo y aleatorio:  openssl rand -hex 32   (obligatorio en producción con el override de Traefik)
PROXY_SECRET=
# Sin autenticación (red privada u otra protección delante): AUTH_DISABLED=true y, con Traefik, INMO_MIDDLEWARES= (vacío)
AUTH_DISABLED=false
AUTH_DEFAULT_USER=anonimo
# Programador diario interno; se activa/desactiva y se le fija la hora desde la pantalla Estado
SCHEDULER_ENABLED=true
# Usuarios de authentik que pueden lanzar el scrapper, separados por coma (vacío = cualquiera con acceso)
RUN_ALLOWED_USERS=
