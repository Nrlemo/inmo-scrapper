# Copiar a .env (ignorado por git) y completar.
TZ=America/Argentina/Buenos_Aires

# Usuario con el que corre el contenedor. Debe poder ESCRIBIR la carpeta de datos (./data o scrapper/data).
# Si ves "unable to open database file", poné aquí tu UID/GID:  id -u  /  id -g
PUID=1000
PGID=1000

# ---- Modo de autenticación ----------------------------------------------------------
#   basic      login propio (usuario/contraseña). La primera vez se abre /setup para crear el administrador.
#   none       sin autenticación (sólo red privada / otra protección delante)
#   authentik  authentik por forward auth (usar además docker-compose.authentik.yml)
AUTH_MODE=basic

# basic: código para la instalación inicial. Vacío = se genera uno al azar y se imprime en el log
# (docker compose logs web | grep INSTALACI). Definilo si preferís no leer el log.
SETUP_TOKEN=
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
COOKIE_SECURE=auto
# Proxies inversos delante de la app: 1 con Traefik (default); 0 si se accede directo (docker-compose.local.yml lo fija en 0)
TRUSTED_PROXY_HOPS=1

# none: nombre con el que actúan todos los visitantes
AUTH_DEFAULT_USER=anonimo

# authentik: secreto largo y aleatorio (openssl rand -hex 32), obligatorio con docker-compose.authentik.yml
PROXY_SECRET=
AUTHENTIK_FORWARD_AUTH_URL=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik

# ---- Traefik (docker-compose.traefik.yml) -------------------------------------------
INMO_DOMAIN=inmo.example.com
TRAEFIK_NETWORK=traefik            # red docker que comparten Traefik (y authentik)
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure

# ---- Otros ---------------------------------------------------------------------------
# Contacto (email o URL) que va en el User-Agent del scrapper, para que el portal pueda avisarte si algo molesta.
# Es un dato personal: no se versiona. Vacío = el User-Agent no lleva contacto.
INMO_CONTACT=

# Usuarios que pueden lanzar el scrapper y cambiar la programación, separados por coma (vacío = todos los autenticados)
RUN_ALLOWED_USERS=
SCHEDULER_ENABLED=true
