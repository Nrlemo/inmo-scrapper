# Copiar como .env junto a docker-compose.yml. Fijar la versión evita actualizaciones sin querer.
INMO_TAG=1.0.2
INMO_PORT=8095
TZ=America/Argentina/Buenos_Aires
AUTH_MODE=basic
TRUSTED_PROXY_HOPS=1
PUID=1000
PGID=1000
# Backups: hora diaria y segunda copia en otro disco u otra máquina (carpeta del host, escribible por PUID)
BACKUP_HORA=05:00
BACKUP_EXTRA=/storage/hdd1tb/server-backup/inmo
